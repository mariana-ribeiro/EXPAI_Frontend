# Configuração do nginx para a imagem Docker do frontend.
# O nginx:alpine substitui ${...} pelas variáveis de ambiente ao arrancar
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Ficheiros da aplicação
    location / {
        try_files $uri $uri/ =404;
    }

    # Configuração gerada no arranque (docker/40-env-json.sh); nunca em cache
    location = /env.json {
        add_header Cache-Control "no-store";
    }

    # Proxy para a API: o browser fala só com este servidor e a chave é
    # acrescentada aqui, por isso nunca chega ao browser.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uploads grandes: sem limite próprio do nginx (a API aplica o dela)
        # e sem guardar o ficheiro inteiro antes de o enviar
        client_max_body_size 0;
        proxy_request_buffering off;

        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
