# ─── Retopo Tool — Variáveis de Ambiente (Exemplo) ─────────────────────────────
# Copie este ficheiro para .env e preencha com as suas credenciais.
# O ficheiro .env NUNCA deve ser enviado para o repositório (.gitignore já o exclui).

# Desenvolvimento local (servidor estático na porta 5500): o browser fala
# diretamente com a API em API_URL, usando API_KEY.
API_URL=
API_KEY=

# Docker (docker compose up): o nginx faz de proxy para a API e acrescenta a
# API_KEY. Endereço da API visto de dentro do contentor (opcional).
# API_UPSTREAM=http://host.docker.internal:8001
